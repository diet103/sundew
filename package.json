{
    "name": "sundew",
    "version": "0.1.0",
    "description": "A guest-first form builder where the form is one JSON document. Drag-and-drop editing, conditional logic, autosave, share links. Runs on Cloudflare Workers + D1.",
    "type": "module",
    "license": "MIT",
    "author": "Dieter Grosswiler",
    "repository": {
        "type": "git",
        "url": "https://github.com/diet103/sundew"
    },
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "vite dev",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "format": "prettier --write .",
        "e2e": "playwright test",
        "deploy": "npm run build && wrangler deploy",
        "db:migrate:local": "wrangler d1 migrations apply DB --local",
        "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "arctic": "^3.7.0",
        "hono": "^4.12.31",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "wouter": "^3.10.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.45.1",
        "@cloudflare/vitest-pool-workers": "^0.18.6",
        "@cloudflare/workers-types": "^5.20260718.1",
        "@playwright/test": "^1.61.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "jsdom": "^29.1.1",
        "prettier": "^3.9.5",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "vitest": "^4.1.10",
        "wrangler": "^4.112.0"
    }
}
