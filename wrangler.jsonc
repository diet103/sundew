{
    "name": "sundew",
    "main": "src/worker/index.ts",
    "compatibility_date": "2026-07-01",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "assets": {
        // Assets-first serving: the store is laid out under /forms/* by
        // scripts/postbuild.mjs (with a root index.html copy as the SPA
        // fallback target and a _headers file for security/cache headers).
        // The worker runs first only for the API, the root redirect, and
        // robots.txt — in dev this lets Vite serve HTML/modules directly.
        "directory": "./dist/client",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/forms/api/*", "/", "/forms/robots.txt"]
    },
    // Cutover: uncomment once dietergrosswiler.com serves traffic through Cloudflare.
    // The more-specific /forms* route wins over the resume worker's custom domain.
    // "routes": [
    //     { "pattern": "dietergrosswiler.com/forms*", "zone_name": "dietergrosswiler.com" }
    // ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "sundew",
            "database_id": "e004a908-5181-401d-95a7-379b5cec1089",
            "migrations_dir": "migrations"
        }
    ],
    "triggers": {
        // Daily cleanup of expired sessions and over-cap leftovers.
        "crons": ["17 4 * * *"]
    },
    "vars": {
        "GOOGLE_CLIENT_ID": "",
        "GITHUB_CLIENT_ID": ""
    }
    // Secrets (wrangler secret put): GOOGLE_CLIENT_SECRET, GITHUB_CLIENT_SECRET.
    // Rate limiting uses a D1 fixed-window counter (see worker/middleware/ratelimit.ts);
    // the Workers rate-limiting binding can replace it later behind the same interface.
}
